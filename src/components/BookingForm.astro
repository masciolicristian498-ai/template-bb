---
const rooms = [
  'Camera Singola',
  'Camera Doppia',
  'Camera Doppia Superior',
  'Suite Junior',
  'Suite Deluxe',
];

const today = new Date().toISOString().split('T')[0];
---

<section class="w-full bg-white py-16 px-4">
  <div class="max-w-2xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-10">
      <span class="inline-block text-amber-600 text-sm font-semibold tracking-widest uppercase mb-2">
        Prenota ora
      </span>
      <h2 class="text-3xl font-bold text-gray-900">Richiedi la tua stanza</h2>
      <p class="mt-2 text-gray-500">Compila il modulo e ti risponderemo su WhatsApp in pochi minuti.</p>
    </div>

    <!-- Form card -->
    <form
      id="booking-form"
      novalidate
      class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 space-y-6"
    >
      <!-- Date row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Check-in -->
        <div class="flex flex-col gap-1.5">
          <label for="check-in" class="text-sm font-medium text-gray-700">
            Data di arrivo
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-amber-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </span>
            <input
              id="check-in"
              name="check-in"
              type="date"
              min={today}
              required
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition"
            />
          </div>
        </div>

        <!-- Check-out -->
        <div class="flex flex-col gap-1.5">
          <label for="check-out" class="text-sm font-medium text-gray-700">
            Data di partenza
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-amber-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </span>
            <input
              id="check-out"
              name="check-out"
              type="date"
              min={today}
              required
              class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-gray-800 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition"
            />
          </div>
        </div>
      </div>

      <!-- Guests + Room row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Guests -->
        <div class="flex flex-col gap-1.5">
          <label for="guests" class="text-sm font-medium text-gray-700">
            Numero di ospiti
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-amber-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-4-4h-1M9 20H4v-2a4 4 0 014-4h1m4-4a4 4 0 110-8 4 4 0 010 8zm6 4a2 2 0 100-4 2 2 0 000 4zM3 16a2 2 0 100-4 2 2 0 000 4z" />
              </svg>
            </span>
            <select
              id="guests"
              name="guests"
              required
              class="w-full pl-10 pr-8 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-gray-800 text-sm appearance-none focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition"
            >
              <option value="" disabled selected>Seleziona…</option>
              {[1, 2, 3, 4, 5, 6].map((n) => (
                <option value={n}>{n} {n === 1 ? 'ospite' : 'ospiti'}</option>
              ))}
            </select>
            <span class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-gray-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </div>
        </div>

        <!-- Room -->
        <div class="flex flex-col gap-1.5">
          <label for="room" class="text-sm font-medium text-gray-700">
            Camera scelta
          </label>
          <div class="relative">
            <span class="absolute inset-y-0 left-3 flex items-center pointer-events-none text-amber-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6" />
              </svg>
            </span>
            <select
              id="room"
              name="room"
              required
              class="w-full pl-10 pr-8 py-2.5 rounded-xl border border-gray-200 bg-gray-50 text-gray-800 text-sm appearance-none focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent transition"
            >
              <option value="" disabled selected>Seleziona…</option>
              {rooms.map((r) => (
                <option value={r}>{r}</option>
              ))}
            </select>
            <span class="absolute inset-y-0 right-3 flex items-center pointer-events-none text-gray-400">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </div>
        </div>
      </div>

      <!-- Error banner (hidden by default) -->
      <p
        id="form-error"
        role="alert"
        class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-xl px-4 py-2.5"
      ></p>

      <!-- Submit -->
      <button
        type="submit"
        class="w-full flex items-center justify-center gap-2 bg-green-500 hover:bg-green-600 active:bg-green-700 text-white font-semibold text-base py-3 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-green-400 focus:ring-offset-2"
      >
        <!-- WhatsApp icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.52 3.48A11.93 11.93 0 0012.01 0C5.38 0 .01 5.37.01 12c0 2.11.55 4.16 1.6 5.97L0 24l6.19-1.62A11.96 11.96 0 0012 24c6.63 0 12-5.37 12-12 0-3.2-1.25-6.21-3.48-8.52zM12 22c-1.85 0-3.65-.5-5.22-1.43l-.37-.22-3.88 1.02 1.04-3.78-.24-.38A9.94 9.94 0 012 12C2 6.49 6.49 2 12 2c2.67 0 5.18 1.04 7.07 2.93A9.93 9.93 0 0122 12c0 5.51-4.49 10-10 10zm5.47-7.4c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.27-.47-2.41-1.49-.89-.8-1.49-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51-.17 0-.37-.01-.57-.01-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.19 5.06 4.48.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35z"/>
        </svg>
        Invia richiesta su WhatsApp
      </button>
    </form>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const WHATSAPP_URL = 'https://wa.me/393331234567?text=';

    /** Formatta una data ISO (YYYY-MM-DD) in formato italiano leggibile */
    function formatDate(iso: string): string {
      const [y, m, d] = iso.split('-');
      return `${d}/${m}/${y}`;
    }

    const form = document.getElementById('booking-form') as HTMLFormElement;
    const errorEl = document.getElementById('form-error') as HTMLParagraphElement;

    if (!form) return;

    function showError(msg: string) {
      errorEl.textContent = msg;
      errorEl.classList.remove('hidden');
    }

    function clearError() {
      errorEl.textContent = '';
      errorEl.classList.add('hidden');
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearError();

      const checkIn  = (document.getElementById('check-in')  as HTMLInputElement).value;
      const checkOut = (document.getElementById('check-out') as HTMLInputElement).value;
      const guests   = (document.getElementById('guests')    as HTMLSelectElement).value;
      const room     = (document.getElementById('room')      as HTMLSelectElement).value;

      // --- Validazione base ---
      if (!checkIn || !checkOut || !guests || !room) {
        showError('Per favore compila tutti i campi prima di inviare la richiesta.');
        return;
      }

      if (checkIn >= checkOut) {
        showError('La data di partenza deve essere successiva alla data di arrivo.');
        return;
      }

      // --- Costruzione messaggio ---
      const message = [
        '🏨 *Richiesta di prenotazione*',
        '',
        `📅 Arrivo:     ${formatDate(checkIn)}`,
        `📅 Partenza:   ${formatDate(checkOut)}`,
        `👥 Ospiti:     ${guests}`,
        `🛏️  Camera:     ${room}`,
        '',
        'Salve! Vorrei ricevere informazioni sulla disponibilità per il soggiorno indicato. Grazie!',
      ].join('\n');

      const url = WHATSAPP_URL + encodeURIComponent(message);
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  });
</script>
