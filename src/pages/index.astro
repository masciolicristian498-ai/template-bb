---
import Layout from '../layouts/Layout.astro';
import BookingForm from '../components/BookingForm.astro';
---

<Layout title="Residenza dei Fiori – B&B nel cuore di Roma">

  <!-- ═══════════════════════════════════════════
       NAVBAR
  ════════════════════════════════════════════ -->
  <header id="top" class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-200 shadow-sm">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">

      <!-- Logo -->
      <a href="#top" class="flex items-center gap-2.5 text-stone-800 hover:text-amber-700 transition">
        <!-- Flower / leaf icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s-8-5.4-8-12a8 8 0 0 1 16 0c0 6.6-8 12-8 12z"/>
          <path d="M12 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" fill="currentColor" stroke="none"/>
        </svg>
        <span class="font-serif text-lg font-semibold tracking-wide">Residenza dei Fiori</span>
      </a>

      <!-- Nav links – hidden on mobile -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-stone-600">
        <a href="#chi-siamo"  class="hover:text-amber-700 transition">Chi siamo</a>
        <a href="#camere"     class="hover:text-amber-700 transition">Camere</a>
        <a href="#posizione"  class="hover:text-amber-700 transition">Posizione</a>
        <a href="#prenota"    class="hover:text-amber-700 transition">Contatti</a>
      </nav>

      <!-- CTA -->
      <a
        href="#prenota"
        class="hidden md:inline-flex items-center gap-1.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-full transition shadow-sm"
      >
        Prenota ora
      </a>

      <!-- Hamburger mobile -->
      <button id="menu-btn" aria-label="Apri menu"
        class="md:hidden p-2 rounded-lg text-stone-600 hover:bg-stone-100 transition">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>

    <!-- Mobile drawer -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-stone-100 bg-white px-6 py-4 space-y-3 text-sm font-medium text-stone-700">
      <a href="#chi-siamo" class="block hover:text-amber-700">Chi siamo</a>
      <a href="#camere"    class="block hover:text-amber-700">Camere</a>
      <a href="#posizione" class="block hover:text-amber-700">Posizione</a>
      <a href="#prenota"   class="block hover:text-amber-700">Prenota</a>
    </div>
  </header>

  <main class="pt-16 font-sans">

    <!-- ═══════════════════════════════════════════
         HERO
    ════════════════════════════════════════════ -->
    <section class="relative min-h-[92vh] flex items-center justify-center overflow-hidden bg-stone-900">
      <!-- Foto Roma reale -->
      <img
        src="https://images.unsplash.com/photo-1552832230-c0197dd311b5?auto=format&fit=crop&w=1920&q=80"
        alt="Colosseo di Roma al tramonto"
        class="absolute inset-0 w-full h-full object-cover object-center opacity-50"
        loading="eager"
      />
      <!-- Overlay gradiente per leggibilità testo -->
      <div class="absolute inset-0 bg-gradient-to-b from-stone-900/40 via-stone-900/30 to-stone-900/60"></div>

      <div class="relative z-10 text-center px-6 max-w-3xl mx-auto">
        <span class="inline-block text-amber-300 text-xs font-semibold tracking-[0.2em] uppercase mb-5 border border-amber-400/50 bg-white/10 backdrop-blur-sm px-4 py-1.5 rounded-full opacity-0 animate-fade-in-up" style="animation-delay: 0.1s">
          B&amp;B · Roma Centro · Rione Monti
        </span>
        <h1 class="font-serif text-5xl md:text-7xl font-bold text-white leading-[1.1] mb-6 opacity-0 animate-fade-in-up" style="animation-delay: 0.2s">
          Il tuo rifugio<br/>nel cuore di Roma
        </h1>
        <p class="text-stone-200 text-lg md:text-xl mb-10 max-w-xl mx-auto leading-relaxed font-light opacity-0 animate-fade-in-up" style="animation-delay: 0.3s">
          Colazione fatta in casa, camere eleganti e la città eterna a due passi dalla porta.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center opacity-0 animate-fade-in-up" style="animation-delay: 0.4s">
          <a href="#prenota"
            class="inline-flex items-center justify-center gap-2 bg-amber-600 hover:bg-amber-700 text-white font-semibold text-base px-8 py-3.5 rounded-full shadow-lg hover:shadow-xl transition-all duration-200">
            Prenota ora
          </a>
          <a href="#camere"
            class="inline-flex items-center justify-center gap-2 bg-white/80 hover:bg-white text-stone-800 font-semibold text-base px-8 py-3.5 rounded-full shadow transition-all duration-200">
            Scopri le camere
          </a>
        </div>
      </div>

      <!-- Scroll arrow -->
      <a href="#chi-siamo"
        class="absolute bottom-8 left-1/2 -translate-x-1/2 text-stone-400 hover:text-amber-700 transition animate-bounce">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </section>

    <!-- ═══════════════════════════════════════════
         CHI SIAMO
    ════════════════════════════════════════════ -->
    <section id="chi-siamo" class="py-24 px-6 bg-white">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-16 items-center">
        <div>
          <span class="inline-block text-amber-600 text-xs font-semibold tracking-[0.2em] uppercase mb-4">Chi siamo</span>
          <h2 class="font-serif text-4xl font-bold text-stone-800 mb-6 leading-snug">
            Ospitalità autentica,<br/>a misura di persona
          </h2>
          <p class="text-stone-500 text-lg leading-relaxed mb-5">
            Benvenuti alla <strong class="text-stone-800 font-semibold">Residenza dei Fiori</strong>, un piccolo gioiello nel rione Monti, a pochi passi dal Colosseo. La nostra è una casa vera — non un albergo — dove ogni mattina prepariamo la colazione con prodotti locali e biologici.
          </p>
          <p class="text-stone-500 text-lg leading-relaxed mb-10">
            Siamo Giulia e Marco, romani doc, felici di consigliarti ristoranti senza turisti, itinerari segreti e tutto ciò che rende Roma unica per chi sa dove guardare.
          </p>

          <ul class="space-y-4">
            {[
              {
                label: 'Colazione artigianale ogni mattina',
                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
              },
              {
                label: 'Check-in flessibile dalle 14:00',
                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
              },
              {
                label: 'Mappa dei locali consigliati inclusa',
                icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>`,
              },
            ].map(item => (
              <li class="flex items-center gap-4">
                <span class="flex-shrink-0 w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center" set:html={item.icon} />
                <span class="text-stone-700 font-medium">{item.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Griglia fotografica Chi siamo -->
        <div class="grid grid-cols-2 gap-4 h-full min-h-[400px]">
          <div class="relative rounded-3xl overflow-hidden shadow-xl col-span-1 row-span-2">
            <img
              src="https://images.unsplash.com/photo-1533089860892-a7c6f0a88666?auto=format&fit=crop&w=600&q=80"
              alt="Colazione artigianale"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
            <div class="absolute bottom-4 left-4 bg-white/90 backdrop-blur-sm rounded-xl px-4 py-2 shadow-sm">
              <p class="text-[10px] text-stone-500 font-semibold tracking-wide uppercase">In attività dal</p>
              <p class="text-xl font-serif font-bold text-amber-600">2012</p>
            </div>
          </div>
          <div class="relative rounded-3xl overflow-hidden shadow-md">
            <img
              src="https://images.unsplash.com/photo-1590490359683-658d3d23f972?auto=format&fit=crop&w=400&q=80"
              alt="Dettaglio design B&B"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
          <div class="relative rounded-3xl overflow-hidden shadow-md">
            <img
              src="https://images.unsplash.com/photo-1515542622106-78bda8cd247a?auto=format&fit=crop&w=400&q=80"
              alt="Vista su Roma"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         LE NOSTRE CAMERE
    ════════════════════════════════════════════ -->
    <section id="camere" class="py-24 px-6 bg-stone-50">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
          <span class="inline-block text-amber-600 text-xs font-semibold tracking-[0.2em] uppercase mb-4">Le nostre camere</span>
          <h2 class="font-serif text-4xl font-bold text-stone-800">Spazi pensati per il tuo comfort</h2>
          <p class="mt-3 text-stone-500 text-lg max-w-xl mx-auto font-light">
            Ogni camera è arredata con cura, dotata di tutto il necessario e immersa nel silenzio del centro storico.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {[
            {
              id: 'room-doppia',
              name: 'Camera Doppia',
              desc: 'Accogliente e luminosa, con letto matrimoniale, parquet antico e vista sul cortile fiorito.',
              badge: 'Da €90/notte',
              imageUrl: 'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=800&q=80',
              imageAlt: 'Camera doppia elegante con letto matrimoniale',
              gallery: [
                'https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=800&q=80',
                'https://images.unsplash.com/photo-1600607686527-6fb886090705?auto=format&fit=crop&w=800&q=80',
                'https://images.unsplash.com/photo-1578683010236-d716f9a3f461?auto=format&fit=crop&w=800&q=80'
              ],
              amenities: [
                { label: 'Wi-Fi',  icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>` },
                { label: 'A/C',    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 19H5c-1 0-2-.9-2-2V7c0-1.1.9-2 2-2h3"/><path d="M16 5h3c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2h-3"/><line x1="12" y1="3" x2="12" y2="21"/><polyline points="8 8 12 12 16 8"/><polyline points="16 16 12 12 8 16"/></svg>` },
                { label: 'Doccia', icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12l1.5-1.5A5 5 0 0 1 12 9h0a5 5 0 0 1 5 5v1"/><path d="M20 14v6"/><path d="M4 14v6"/><path d="M4 20h16"/></svg>` },
                { label: 'TV',     icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>` },
              ],
            },
            {
              id: 'room-superior',
              name: 'Camera Doppia Superior',
              desc: 'Più spaziosa, con soffitti affrescati originali del \'700, vasca da bagno e minibar incluso.',
              badge: 'Da €130/notte',
              imageUrl: 'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=800&q=80',
              imageAlt: 'Camera superior con arredi eleganti e vasca',
              gallery: [
                'https://images.unsplash.com/photo-1596394518184-5f78ff2ddbf3?auto=format&fit=crop&w=800&q=80',
                'https://images.unsplash.com/photo-1622866306950-81d09ee4caeb?auto=format&fit=crop&w=800&q=80',
                'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=800&q=80'
              ],
              amenities: [
                { label: 'Wi-Fi',   icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>` },
                { label: 'A/C',     icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 19H5c-1 0-2-.9-2-2V7c0-1.1.9-2 2-2h3"/><path d="M16 5h3c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2h-3"/><line x1="12" y1="3" x2="12" y2="21"/><polyline points="8 8 12 12 16 8"/><polyline points="16 16 12 12 8 16"/></svg>` },
                { label: 'Vasca',   icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6L9 2"/><path d="M15 6V2"/><path d="M2 12h20v4a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-4z"/><path d="M4 12V8a2 2 0 0 1 2-2h2"/></svg>` },
                { label: 'Minibar', icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 22H16"/><path d="M12 11V22"/><path d="M20 2L16.5 11H7.5L4 2Z"/></svg>` },
              ],
            },
            {
              id: 'room-suite',
              name: 'Suite Junior',
              desc: 'Il nostro fiore all\'occhiello: salottino separato, terrazzino privato con vista sui tetti di Roma.',
              badge: 'Da €180/notte',
              imageUrl: 'https://images.unsplash.com/photo-1582719508461-905c673771fd?auto=format&fit=crop&w=800&q=80',
              imageAlt: 'Suite junior con terrazzo e vista sui tetti di Roma',
              gallery: [
                'https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=800&q=80',
                'https://images.unsplash.com/photo-1531834685032-c34bf0d84c77?auto=format&fit=crop&w=800&q=80',
                'https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=800&q=80'
              ],
              amenities: [
                { label: 'Wi-Fi',             icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>` },
                { label: 'A/C',               icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 19H5c-1 0-2-.9-2-2V7c0-1.1.9-2 2-2h3"/><path d="M16 5h3c1.1 0 2 .9 2 2v10c0 1.1-.9 2-2 2h-3"/><line x1="12" y1="3" x2="12" y2="21"/><polyline points="8 8 12 12 16 8"/><polyline points="16 16 12 12 8 16"/></svg>` },
                { label: 'Terrazzo',          icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` },
                { label: 'Colazione in stanza', icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>` },
              ],
            },
          ].map((room) => (
            <>
              <article class="bg-white rounded-3xl shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden flex flex-col group relative">
                <!-- Immagine camera reale -->
                <div class="aspect-video relative overflow-hidden">
                  <img
                    src={room.imageUrl}
                    alt={room.imageAlt}
                    class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <span class="absolute top-3 right-3 bg-amber-600 text-white text-xs font-bold px-3 py-1 rounded-full shadow">
                    {room.badge}
                  </span>
                </div>

                <div class="p-6 flex flex-col flex-1">
                  <h3 class="font-serif text-xl font-bold text-stone-800 mb-2">{room.name}</h3>
                  <p class="text-stone-500 text-sm leading-relaxed flex-1">{room.desc}</p>

                  <div class="mt-5 pt-4 border-t border-stone-100 flex flex-wrap gap-2">
                    {room.amenities.map((a) => (
                      <span class="inline-flex items-center gap-1.5 text-xs font-medium text-stone-600 bg-stone-100 px-2.5 py-1.5 rounded-full">
                        <span class="text-amber-600" set:html={a.icon} />
                        {a.label}
                      </span>
                    ))}
                  </div>

                  <div class="mt-6 flex flex-col gap-3">
                    <button
                      onclick={`document.getElementById('${room.id}').showModal()`}
                      class="w-full text-center text-sm font-semibold text-white bg-stone-800 hover:bg-stone-900 active:scale-95 py-2.5 rounded-xl transition-all duration-200 flex items-center justify-center gap-2 shadow-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      Vedi dettagli e foto
                    </button>
                    <a href="#prenota"
                      class="w-full text-center text-sm font-semibold text-amber-700 hover:text-white border border-amber-600 hover:bg-amber-600 py-2.5 rounded-xl transition-all duration-200">
                      Richiedi disponibilità
                    </a>
                  </div>
                </div>
              </article>

              <!-- Modale Lightbox (dialog) -->
              <dialog id={room.id} class="backdrop:bg-stone-900/80 p-0 rounded-3xl shadow-2xl max-w-3xl w-11/12 mx-auto open:animate-in open:fade-in open:zoom-in-95 bg-white overflow-hidden">
                <div class="p-6 border-b border-stone-100 flex items-center justify-between sticky top-0 bg-white/95 backdrop-blur z-10">
                  <h3 class="font-serif text-2xl font-bold text-stone-800">{room.name}</h3>
                  <form method="dialog">
                    <button class="p-2 rounded-full hover:bg-stone-100 text-stone-500 hover:text-stone-800 transition-colors">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                  </form>
                </div>
                <div class="p-6">
                  <p class="text-stone-600 text-base mb-6 leading-relaxed">{room.desc}</p>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    {room.gallery.map((img) => (
                      <div class="aspect-[4/3] rounded-2xl overflow-hidden shadow-sm">
                        <img src={img} alt="Foto dettaglio camera" class="w-full h-full object-cover object-center hover:scale-110 transition-transform duration-500" loading="lazy" />
                      </div>
                    ))}
                  </div>
                  <div class="mt-8 text-center">
                    <form method="dialog">
